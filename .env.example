# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=petfood
POSTGRES_PASSWORD=petfood
POSTGRES_DB=petfood
POSTGRES_PORT=5432
DATABASE_URL=postgresql://petfood:petfood@localhost:5432/petfood

# S3 — SeaweedFS locally; for AWS S3 set S3_ENDPOINT_URL empty and use real keys
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=petfood-papers
S3_REGION=us-east-1

QDRANT_URL=http://localhost:6333

# LLMs (used from Phase 3)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://localhost:11434
FASTEMBED_CACHE_DIR=~/.cache/fastembed
LOCAL_MODEL=qwen3:4b
LOCAL_THINK=false
LOCAL_NUM_CTX=8192

# Ingestion
CONTACT_EMAIL=you@example.com
